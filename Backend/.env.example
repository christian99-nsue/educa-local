# ========================================
# Variables de Entorno - Ejemplo
# ========================================
# Copia este archivo a .env y rellena los valores reales

# ========================================
# SERVIDOR
# ========================================
PORT=3000

# ========================================
# BASE DE DATOS (MySQL)
# ========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=educa_local
DB_PORT=3306

# Opcional: Para múltiples entornos
# DB_TARGET=railway
# DB_HOST_RAILWAY=your-railway-host
# DB_USER_RAILWAY=your-railway-user
# DB_PASSWORD_RAILWAY=your-railway-password
# DB_NAME_RAILWAY=your-railway-db
# DB_PORT_RAILWAY=5432

# ========================================
# SEGURIDAD (JWT)
# ========================================
JWT_SECRET=tu_secreto_jwt_muy_seguro_aqui_cambiar_en_produccion

# ========================================
# EMAIL (Gmail SMTP)
# ========================================
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_app_gmail

# ========================================
# FRONTEND URL (Para enlaces en emails y notificaciones)
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# SUPABASE (Almacenamiento de archivos)
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ========================================
# GOOGLE OAUTH (Opcional)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ========================================
# MICROSOFT OAUTH / AZURE AD (Opcional)
# ========================================
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id

# ========================================
# BASE DE DATOS (Destino)
# ========================================
# LOCAL: Usa las variables DB_* sin sufijo
# RAILWAY: Usa las variables DB_*_RAILWAY
